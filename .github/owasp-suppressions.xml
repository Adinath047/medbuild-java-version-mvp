<?xml version="1.0" encoding="UTF-8"?>
<!--
    OWASP Dependency Check CVE Suppressions
    =========================================
    PURPOSE
    -------
    This file lists CVE identifiers that are deliberately excluded from the
    OWASP Dependency Check failing gate. Suppressions must NEVER be added
    silently or unilaterally.

    PROCESS — all three conditions are required before adding any entry:
      1. SECURITY REVIEW: The false-positive or non-applicability rationale
         must be documented in a GitHub Issue tagged "security-review".
      2. DUAL SIGN-OFF: At least two team members with the "security-reviewer"
         GitHub role must approve the PR that adds the suppression.
      3. EXPIRY DATE: Every suppression entry MUST include an <until> date no
         more than 90 days in the future. Suppressions with no <until> date
         or past their expiry will cause the OWASP plugin to warn and may
         cause the build to fail depending on plugin version configuration.

    TEMPLATE — copy this block for each new suppression:

        <suppress until="YYYY-MM-DD">
            <notes>
                ISSUE: https://github.com/Adinath047/medbuild-java-version-mvp/issues/XXX
                CVE: CVE-YYYY-NNNNN
                RATIONALE: Explain why this is a false positive or why the
                vulnerability is not exploitable in the Medbuilds EMR context.
                Reviewed by: @reviewer1, @reviewer2
                Next review: YYYY-MM-DD (must be before the until date above)
            </notes>
            <cve>CVE-YYYY-NNNNN</cve>
        </suppress>

    WARNING:
      - Never suppress CRITICAL CVEs (CVSS >= 9.0) without explicit written
        authorization from the Engineering Lead and documented in the GitHub
        Issue referenced above.
      - Expired suppressions must be renewed or removed; stale entries
        undermine the integrity of the security gate.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        No active suppressions.
        Any future suppression requires the process documented above.
    -->
</suppressions>
